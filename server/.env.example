NODE_ENV=development

PORT=5000

CLIENT_URL=http://localhost:5173

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

SMTP_USER=
SMTP_PASS=

EMAIL_FROM=no-reply@eduflow.com

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@eduflow.com
ADMIN_PHONE=+8801700000000
ADMIN_PASSWORD=Admin@12345


SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_IS_LIVE=false

# SSLCommerz Sandbox Configuration
# IMPORTANT:
# - Use the STORE PASSWORD from SSLCommerz Merchant Dashboard (NOT your login password).
# - Store ID and Store Password are different from your merchant login credentials.
# - Ensure the store is ACTIVE in the SSLCommerz dashboard.
# - For sandbox testing, set SSL_IS_LIVE=false.
# - Callback URLs must be publicly reachable by SSLCommerz. Localhost is NOT reachable from the gateway.
#   Use ngrok, Vercel preview, or any public HTTPS URL.
PAYMENT_SUCCESS_URL=
PAYMENT_FAIL_URL=
PAYMENT_CANCEL_URL=
PAYMENT_IPN_URL=

# Chatbot AI Configuration
# Leave empty to disable AI generation; the chatbot will still respond with a graceful unavailable message.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=30000